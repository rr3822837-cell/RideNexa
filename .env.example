# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign authentication tokens.
JWT_SECRET="replace-with-a-strong-random-secret"

# MONGODB_URI: Optional MongoDB connection string. When omitted, RideNexa runs in persistent local demo mode.
MONGODB_URI=""

# ML_SERVICE_URL: Optional Python FastAPI ML service endpoint (e.g., http://localhost:8000).
ML_SERVICE_URL=""

# DRIVER_RESPONSE_TIMEOUT: Seconds allowed for a driver to respond to an incoming ride request.
DRIVER_RESPONSE_TIMEOUT="30"
# DRIVER_SEARCH_INTERVAL_SEC: Seconds between periodic availability checks while searching for a driver.
DRIVER_SEARCH_INTERVAL_SEC="4"
# MAX_BOOKING_WAIT_SEC: Maximum seconds to keep searching automatically before prompting passenger to continue waiting or cancel.
MAX_BOOKING_WAIT_SEC="180"

# Server-side Admin Provisioning (never exposed to browser)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="RideNexa Administrator"
ADMIN_SETUP_SECRET=""

# Payment Gateway Configuration (Optional - runs in clearly labelled Sandbox/Demo mode when omitted)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
SANDBOX_PAYMENT_SECRET=""
PRICING_PLATFORM_FEE="0"

# SOS Emergency & Personal Safety System Configuration
EMERGENCY_NUMBER="112"
EMERGENCY_COUNTRY="IN"
POLICE_EMERGENCY_API_URL=""
POLICE_EMERGENCY_API_KEY=""
SOS_RETENTION_DAYS="90"
